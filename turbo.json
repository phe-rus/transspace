{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".output/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "type-gen": {
      "dependsOn": [
        "^type-gen"
      ]
    },
    "postinstall": {
      "dependsOn": [
        "^postinstall"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}