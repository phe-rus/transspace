{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "transspace",
    "compatibility_date": "2026-02-09",
    "compatibility_flags": ["nodejs_compat"],
    "main": "src/server.ts",
    "observability": {
        "enabled": true
    },
    "placement": {
        "mode": "smart"
    },
    "workers_dev": false,
    "preview_urls": false
}
