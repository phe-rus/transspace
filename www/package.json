{
  "name": "transspace",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port=3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "type-gen": "wrangler types",
    "postinstall": "bun run type-gen",
    "translate": "inlang machine translate --project project.inlang",
    "auth:gen": "bun x auth@latest generate --config=./src/lib/auth.ts --output=./src/schemas/auth.ts --yes",
    "db:gen": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "db:local": "bunx wrangler d1 migrations apply transspace --local",
    "db:remote": "bunx wrangler d1 migrations apply transspace --remote",
    "db:studio": "bunx drizzle-kit studio --config=drizzle.config.ts",
    "local": "bun run auth:gen && bun run db:gen && bun run db:local",
    "remote": "bun run local && bun run db:remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@pherus/rich-text": "workspace:*",
    "@pherus/ui": "workspace:*",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@inlang/cli": "^3.3.4",
    "@inlang/paraglide-js": "^2.25.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "web-vitals": "^6.2.1",
    "wrangler": "^4.137.0"
  }
}